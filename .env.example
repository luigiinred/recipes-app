# Copy to .env and fill in your values. Do not commit .env (this repo is public).

# App Store Connect API key (used by bin/publish_testflight.sh)
# Key file must live at ~/.private_keys/AuthKey_${ASC_KEY_ID}.p8
# Create the key at App Store Connect → Users and Access → Keys.
ASC_KEY_ID=your_key_id
ASC_ISSUER_ID=your_issuer_id
